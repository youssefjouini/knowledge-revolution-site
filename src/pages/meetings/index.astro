---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import Icon from '@/components/ui/Icon.astro';
import Todo from '@/components/ui/Todo.astro';
import { formatDate } from '@/lib/utils';

const meetings = (await getCollection('meetings', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const typeLabel = { team: 'Team meeting', supervisors: 'With supervisors', partner: 'With partner' };
---
<BaseLayout title="Meetings & Minutes" description="Every meeting of the FBAI's team: attendees, agenda, decisions and next steps.">
  <PageHeader
    eyebrow="Meetings & minutes"
    title="Every decision,"
    accent="on the record."
    lead="The minutes of our team meetings and our sessions with our supervisors — who was there, what we discussed, what we decided and what comes next."
  />

  <section class="container-page pb-24 md:pb-32">
    {meetings.length === 0 ? (
      <div class="glass mx-auto max-w-2xl p-10 text-center" data-reveal>
        <span class="mx-auto mb-6 flex size-14 items-center justify-center rounded-full border border-cyan/30 bg-cyan/10 text-cyan"><Icon name="calendar" class="size-6" /></span>
        <h2 class="font-display text-3xl">No minutes published yet</h2>
        <p class="mt-3 text-mist">The first minutes will appear here as the Investigate phase starts.</p>
        <div class="mt-6"><Todo>Add one file per meeting in src/content/meetings/ (see README)</Todo></div>
      </div>
    ) : (
      <ol class="relative mx-auto max-w-4xl">
        <!-- the line that draws itself on scroll -->
        <div class="absolute top-2 bottom-2 left-[1.1rem] w-px bg-white/10 md:left-1/2" aria-hidden="true">
          <div data-draw class="absolute inset-0 origin-top bg-gradient-to-b from-cyan via-gold to-cyan"></div>
        </div>
        {meetings.map((m, i) => (
          <li class:list={['relative mb-12 pl-12 md:w-1/2 md:pl-0', i % 2 ? 'md:ml-auto md:pl-12' : 'md:pr-12 md:text-right']}>
            <span class:list={['absolute top-6 left-[1.1rem] size-3.5 -translate-x-1/2 rounded-full bg-gold ring-4 ring-navy-950', i % 2 ? 'md:left-0' : 'md:left-full']} aria-hidden="true"></span>
            <a href={`/meetings/${m.id}`} class="glass glass-hover group block p-6 text-left" data-reveal data-tilt="4">
              <p class="flex flex-wrap items-center gap-2 font-label text-xs text-mist">
                <time datetime={m.data.date.toISOString()} class="font-semibold text-gold">{formatDate(m.data.date)}</time>
                <span class="chip !py-0.5">{typeLabel[m.data.type]}</span>
                <span class="chip !py-0.5">{m.data.cbl_phase}</span>
              </p>
              <h2 class="mt-3 font-display text-2xl text-ink">{m.data.title}</h2>
              {m.data.summary && <p class="mt-2 text-sm text-mist">{m.data.summary}</p>}
              <span class="mt-4 inline-flex items-center gap-2 font-label text-sm font-semibold text-cyan">
                Read the minutes <Icon name="arrow-right" class="size-4 transition group-hover:translate-x-1" />
              </span>
            </a>
          </li>
        ))}
      </ol>
    )}
  </section>
</BaseLayout>
