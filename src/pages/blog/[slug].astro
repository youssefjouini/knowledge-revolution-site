---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import { formatDate, readingTime } from '@/lib/utils';
import { site } from '@/data/site';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  // "previous" = older post, "next" = newer post
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  newer?: CollectionEntry<'blog'>;
  older?: CollectionEntry<'blog'>;
}
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, date, category, tags, cover, coverAlt, excerpt } = post.data;
---
<BaseLayout title={title} description={excerpt} image={cover} type="article" publishedTime={date}>
  <article class="pt-32 pb-24">
    <header class="container-page max-w-4xl">
      <a href="/blog" class="inline-flex items-center gap-2 font-label text-sm text-mist hover:text-ink"><Icon name="arrow-left" class="size-4" /> All posts</a>
      <p class="mt-8 flex flex-wrap items-center gap-3 font-label text-xs text-mist">
        <span class="chip !border-gold/40 !text-gold">{category}</span>
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime(post.body)} min read</span>
      </p>
      <h1 class="title-serif mt-5 text-4xl md:text-6xl">{title}</h1>
      <p class="lead mt-5">{excerpt}</p>
    </header>

    {cover && (
      <div class="container-page mt-12 max-w-5xl">
        <Image src={cover} alt={coverAlt ?? ''} widths={[640, 1024, 1600]} sizes="(min-width: 1024px) 1024px, 100vw" class="w-full rounded-3xl border border-white/10 object-cover" loading="eager" fetchpriority="high" />
      </div>
    )}

    <div class="container-page mt-14 max-w-3xl">
      <div class="prose prose-lg prose-invert prose-kr max-w-none">
        <Content />
      </div>

      {tags.length > 0 && (
        <p class="mt-12 flex flex-wrap gap-2">{tags.map((t) => <span class="chip">#{t}</span>)}</p>
      )}

      <div class="glass mt-12 flex flex-col items-start gap-4 p-6 sm:flex-row sm:items-center">
        <span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-gold/15 text-gold"><Icon name="instagram" class="size-5" /></span>
        <p class="flex-1 text-sm text-mist">Follow the journey day by day on Instagram.</p>
        <a href={site.instagram.url} target="_blank" rel="noopener" class="btn-ghost !py-2.5">{site.instagram.handle}</a>
      </div>

      <nav class="mt-16 grid gap-4 border-t border-white/10 pt-8 sm:grid-cols-2" aria-label="More posts">
        {older ? (
          <a href={`/blog/${older.id}`} class="glass glass-hover group p-5">
            <span class="font-label text-xs text-mist">← Previous post</span>
            <span class="mt-1 block font-display text-lg text-ink">{older.data.title}</span>
          </a>
        ) : <span></span>}
        {newer && (
          <a href={`/blog/${newer.id}`} class="glass glass-hover group p-5 text-right">
            <span class="font-label text-xs text-mist">Next post →</span>
            <span class="mt-1 block font-display text-lg text-ink">{newer.data.title}</span>
          </a>
        )}
      </nav>
    </div>
  </article>
</BaseLayout>
