---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import { colorOf } from '@/components/journal/types';
import { formatDate, readingTime } from '@/lib/utils';
import { site } from '@/data/site';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, all: posts, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  all: CollectionEntry<'blog'>[];
  newer?: CollectionEntry<'blog'>;
  older?: CollectionEntry<'blog'>;
}
const { post, all, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const { title, date, category, tags, cover, coverAlt, excerpt } = post.data;
const minutes = readingTime(post.body);
const color = colorOf(category);
const toc = headings.filter((h) => h.depth === 2);
const url = new URL(Astro.url.pathname, Astro.site).toString();
const index = all.findIndex((p) => p.id === post.id);

// Related: same category first, then shared tags
const related = all
  .filter((p) => p.id !== post.id)
  .map((p) => ({ p, score: (p.data.category === category ? 2 : 0) + p.data.tags.filter((t) => tags.includes(t)).length }))
  .filter((r) => r.score > 0)
  .sort((a, b) => b.score - a.score || b.p.data.date.valueOf() - a.p.data.date.valueOf())
  .slice(0, 3)
  .map((r) => r.p);
---
<BaseLayout title={title} description={excerpt} image={cover} type="article" publishedTime={date}>
  <!-- reading progress -->
  <div class="fixed inset-x-0 top-0 z-[70] h-[3px] bg-white/5" aria-hidden="true">
    <div id="read-progress" class="h-full origin-left scale-x-0 bg-gradient-to-r from-gold via-coral to-cyan"></div>
  </div>

  <article class="pt-32 pb-12" style={`--c:${color}`}>
    <!-- ============ header ============ -->
    <header class="container-page max-w-5xl">
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 font-label text-xs text-mist">
        <a href="/blog" class="inline-flex items-center gap-2 hover:text-ink"><Icon name="arrow-left" class="size-4" /> The Journal</a>
        <span aria-hidden="true">/</span>
        <a href={`/blog?cat=${encodeURIComponent(category)}`} class="font-bold tracking-wider uppercase hover:underline" style={`color:${color}`}>{category}</a>
      </nav>

      <p class="mt-8 font-label text-[0.7rem] font-semibold tracking-[0.25em] text-mist uppercase">
        Nº {String(all.length - index).padStart(2, '0')} · <time datetime={date.toISOString()}>{formatDate(date)}</time> · {minutes} min read
      </p>
      <h1 class="post-title title-serif mt-4 text-[clamp(2.6rem,6vw,5.2rem)] leading-[1.02]">
        {title.split(' ').map((w, i) => (
          <span class="pt-word inline-block" style={`--d:${i * 55}ms`}>{w}&nbsp;</span>
        ))}
      </h1>
      <p class="lead mt-6 max-w-3xl">{excerpt}</p>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <span class="flex items-center gap-3">
          <span class="flex size-10 items-center justify-center rounded-full bg-gold font-label text-xs font-extrabold text-navy">FB</span>
          <span class="leading-tight">
            <span class="block text-sm font-semibold text-ink">{site.team} team</span>
            <span class="block text-xs text-mist">{site.teamLong}</span>
          </span>
        </span>
        <span class="hidden h-8 w-px bg-white/10 sm:block"></span>
        <div class="flex gap-2">
          <button type="button" data-copy={url} class="share-btn" aria-label="Copy the link to this post">
            <Icon name="link" class="size-4" /> <span data-copy-label>Copy link</span>
          </button>
          <a class="share-btn" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`} target="_blank" rel="noopener" aria-label="Share on LinkedIn (opens in a new tab)">
            <Icon name="linkedin" class="size-4" /> Share
          </a>
        </div>
      </div>
    </header>

    <!-- ============ cover ============ -->
    {cover && (
      <div class="container-page mt-12 max-w-6xl">
        <div class="post-cover relative overflow-hidden rounded-[2rem] border border-white/10">
          <Image src={cover} alt={coverAlt ?? ''} widths={[640, 1024, 1600]} sizes="(min-width: 1280px) 1152px, 100vw" class="post-cover-img aspect-[16/8] w-full object-cover" loading="eager" fetchpriority="high" />
          <span class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-navy-950/60 to-transparent"></span>
        </div>
      </div>
    )}

    <!-- ============ body ============ -->
    <div class="container-page mt-14 grid max-w-6xl gap-12 lg:grid-cols-[15rem_minmax(0,1fr)]">
      <aside class="hidden lg:block">
        <div class="sticky top-28 space-y-8">
          <div class="flex items-center gap-4">
            <svg viewBox="0 0 44 44" class="size-14 -rotate-90" aria-hidden="true">
              <circle cx="22" cy="22" r="19" fill="none" stroke="rgb(255 255 255 / 0.1)" stroke-width="3" />
              <circle id="read-ring" cx="22" cy="22" r="19" fill="none" stroke={color} stroke-width="3" stroke-linecap="round" stroke-dasharray="119.4" stroke-dashoffset="119.4" />
            </svg>
            <p class="leading-tight">
              <span id="read-left" class="block font-label text-lg font-extrabold text-ink">{minutes} min</span>
              <span id="read-left-label" class="font-label text-[0.65rem] tracking-[0.2em] text-mist uppercase">left to read</span>
            </p>
          </div>

          {toc.length > 0 && (
            <nav aria-label="On this page">
              <p class="eyebrow mb-4">On this page</p>
              <ol class="toc space-y-1 border-l border-white/10">
                {toc.map((h, i) => (
                  <li>
                    <a href={`#${h.slug}`} data-toc={h.slug} class="toc-link -ml-px block border-l-2 border-transparent py-1.5 pl-4 text-sm text-mist transition hover:text-ink">
                      <span class="mr-2 font-label text-[0.65rem] text-mist/60">{String(i + 1).padStart(2, '0')}</span>{h.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )}
        </div>
      </aside>

      <div id="post-body" class="min-w-0">
        <div class="prose prose-lg prose-invert prose-kr post-prose max-w-none">
          <Content />
        </div>

        {tags.length > 0 && (
          <p class="mt-12 flex flex-wrap gap-2">
            {tags.map((t) => <span class="chip">#{t}</span>)}
          </p>
        )}

        <div class="glass mt-12 flex flex-col items-start gap-4 p-6 sm:flex-row sm:items-center">
          <span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-gold/15 text-gold"><Icon name="instagram" class="size-5" /></span>
          <p class="flex-1 text-sm text-mist">Enjoyed this chapter? Follow the journey day by day on Instagram.</p>
          <a href={site.instagram.url} target="_blank" rel="noopener" class="btn-ghost !py-2.5">{site.instagram.handle}</a>
        </div>
      </div>
    </div>
  </article>

  <!-- ============ keep reading ============ -->
  <section class="container-page max-w-6xl pb-8">
    {related.length > 0 && (
      <div class="mb-16">
        <p class="eyebrow mb-3">Keep reading</p>
        <h2 class="title-serif mb-8 text-3xl md:text-4xl">More from <em>the journal.</em></h2>
        <ul class="grid gap-5 md:grid-cols-3">
          {related.map((r) => (
            <li>
              <a href={`/blog/${r.id}`} class="glass glass-hover group block h-full overflow-hidden" style={`--c:${colorOf(r.data.category)}`}>
                <div class="relative aspect-[16/9] overflow-hidden bg-navy-700">
                  {r.data.cover && <Image src={r.data.cover} alt="" widths={[400, 700]} sizes="(min-width: 768px) 360px, 100vw" class="size-full object-cover transition duration-700 group-hover:scale-110" />}
                </div>
                <div class="p-5">
                  <p class="font-label text-[0.68rem] font-bold tracking-wider uppercase" style={`color:${colorOf(r.data.category)}`}>{r.data.category}</p>
                  <p class="mt-1 font-display text-xl leading-snug text-ink">{r.data.title}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <nav class="grid overflow-hidden rounded-[2rem] border border-white/10 md:grid-cols-2" aria-label="Previous and next posts">
      {older ? (
        <a href={`/blog/${older.id}`} class="pn-link group relative isolate block overflow-hidden p-8 md:p-10">
          {older.data.cover && <Image src={older.data.cover} alt="" width={800} class="pn-bg absolute inset-0 -z-10 size-full object-cover" />}
          <span class="font-label text-xs tracking-[0.2em] text-mist uppercase">← Previous chapter</span>
          <span class="mt-2 block font-display text-2xl text-ink md:text-3xl">{older.data.title}</span>
        </a>
      ) : (
        <span class="hidden p-10 md:block"></span>
      )}
      {newer ? (
        <a href={`/blog/${newer.id}`} class="pn-link group relative isolate block overflow-hidden border-t border-white/10 p-8 text-right md:border-t-0 md:border-l md:p-10">
          {newer.data.cover && <Image src={newer.data.cover} alt="" width={800} class="pn-bg absolute inset-0 -z-10 size-full object-cover" />}
          <span class="font-label text-xs tracking-[0.2em] text-mist uppercase">Next chapter →</span>
          <span class="mt-2 block font-display text-2xl text-ink md:text-3xl">{newer.data.title}</span>
        </a>
      ) : (
        <a href="/blog" class="pn-link group relative isolate block border-t border-white/10 p-8 text-right md:border-t-0 md:border-l md:p-10">
          <span class="font-label text-xs tracking-[0.2em] text-mist uppercase">You're up to date</span>
          <span class="mt-2 block font-display text-2xl text-ink md:text-3xl">Back to the Journal →</span>
        </a>
      )}
    </nav>
  </section>
</BaseLayout>

<style>
  .pt-word { animation: wordUp 0.9s var(--ease-out-expo) both; animation-delay: var(--d); }
  @keyframes wordUp { from { opacity: 0; transform: translateY(0.45em); filter: blur(6px); } }

  .post-cover { animation: coverIn 1.3s 0.2s var(--ease-out-expo) both; }
  @keyframes coverIn { from { clip-path: inset(12% 8% 12% 8% round 2rem); opacity: 0.4; } to { clip-path: inset(0 0 0 0 round 2rem); } }
  .post-cover-img { transform: scale(1.1); transform-origin: center; will-change: transform; }

  .share-btn {
    display: inline-flex; align-items: center; gap: 0.5rem;
    border-radius: 9999px; border: 1px solid rgb(255 255 255 / 0.12);
    padding: 0.5rem 1rem; font-family: var(--font-label); font-size: 0.75rem; font-weight: 600; color: var(--color-mist);
    transition: color .2s, border-color .2s, background .2s;
  }
  .share-btn:hover { color: var(--color-ink); border-color: var(--c); background: rgb(255 255 255 / 0.04); }

  .toc-link.is-active { color: var(--color-ink); border-left-color: var(--c); }

  .pn-link { transition: background .4s; }
  .pn-bg { opacity: 0; transform: scale(1.1); transition: opacity .6s, transform 1.2s var(--ease-out-expo); filter: brightness(0.35) saturate(1.2); }
  .pn-link:hover .pn-bg, .pn-link:focus-visible .pn-bg { opacity: 1; transform: scale(1); }

  @media (prefers-reduced-motion: reduce) {
    .pt-word, .post-cover { animation: none; }
  }
</style>

<style is:global>
  /* Article typography: drop cap + pull quotes */
  .post-prose > p:first-of-type::first-letter {
    float: left;
    font-family: var(--font-display);
    font-size: 4.6em;
    line-height: 0.8;
    padding: 0.08em 0.12em 0 0;
    color: var(--c, var(--color-gold));
    font-weight: 500;
  }
  .post-prose blockquote {
    position: relative;
    border: 0;
    margin: 2.5rem 0;
    padding: 1.5rem 1.5rem 1.5rem 3.5rem;
    border-radius: 1.5rem;
    background: linear-gradient(135deg, rgb(255 255 255 / 0.06), rgb(255 255 255 / 0.01));
    font-family: var(--font-display);
    font-size: 1.45em;
    line-height: 1.35;
    color: var(--color-ink);
  }
  .post-prose blockquote::before {
    content: "“";
    position: absolute;
    left: 0.9rem;
    top: 0.2rem;
    font-size: 3.2em;
    line-height: 1;
    color: var(--c, var(--color-gold));
    font-family: var(--font-display);
  }
  .post-prose blockquote p { margin: 0.2em 0; }
  .post-prose h2 { scroll-margin-top: 7rem; }
  .post-prose h2::before {
    content: "";
    display: block;
    width: 2.5rem;
    height: 3px;
    border-radius: 3px;
    margin-bottom: 0.9rem;
    background: var(--c, var(--color-gold));
  }
  .post-prose a { text-decoration-color: color-mix(in srgb, var(--c) 60%, transparent); }
</style>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const body = document.getElementById('post-body');
  const bar = document.getElementById('read-progress');
  const ring = document.getElementById('read-ring');
  const left = document.getElementById('read-left');
  const leftLabel = document.getElementById('read-left-label');
  const coverImg = document.querySelector<HTMLElement>('.post-cover-img');
  const total = Number(left?.textContent?.replace(/\D/g, '') || 1);
  const C = 119.4;

  let raf = 0;
  const update = () => {
    raf = 0;
    if (!body) return;
    const r = body.getBoundingClientRect();
    const vh = window.innerHeight;
    const p = Math.min(1, Math.max(0, (vh * 0.35 - r.top) / (r.height - vh * 0.35)));
    if (bar) bar.style.transform = `scaleX(${p})`;
    if (ring) ring.setAttribute('stroke-dashoffset', String(C * (1 - p)));
    if (left) left.textContent = p >= 0.98 ? 'Done ✓' : `${Math.max(1, Math.ceil(total * (1 - p)))} min`;
    if (leftLabel) leftLabel.textContent = p >= 0.98 ? 'Thanks for reading' : 'left to read';
    if (coverImg && !reduced) {
      const cr = coverImg.getBoundingClientRect();
      const shift = Math.max(-1, Math.min(1, (cr.top + cr.height / 2 - vh / 2) / vh));
      coverImg.style.transform = `scale(1.1) translateY(${shift * 30}px)`;
    }
  };
  const onScroll = () => { if (!raf) raf = requestAnimationFrame(update); };
  update();
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);

  // Table of contents follows the reading
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')];
  const heads = links.map((l) => document.getElementById(l.dataset.toc!)).filter(Boolean) as HTMLElement[];
  if (heads.length) {
    const setActive = () => {
      let current = heads[0].id;
      for (const h of heads) if (h.getBoundingClientRect().top < window.innerHeight * 0.3) current = h.id;
      links.forEach((l) => l.classList.toggle('is-active', l.dataset.toc === current));
    };
    setActive();
    window.addEventListener('scroll', () => requestAnimationFrame(setActive), { passive: true });
  }

  // Copy link
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const label = btn.querySelector('[data-copy-label]');
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        if (label) label.textContent = 'Copied!';
      } catch {
        if (label) label.textContent = 'Copy failed';
      }
      setTimeout(() => label && (label.textContent = 'Copy link'), 1800);
    });
  });
</script>
