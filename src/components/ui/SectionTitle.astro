---
interface Props { eyebrow?: string; title: string; accent?: string; lead?: string; center?: boolean; class?: string; as?: 'h2' | 'h3' }
const { eyebrow, title, accent, lead, center = false, class: cls, as: Tag = 'h2' } = Astro.props;
---
<div class:list={['mb-12 max-w-3xl', center && 'mx-auto text-center', cls]}>
  {eyebrow && <p class="eyebrow mb-4" data-reveal>{eyebrow}</p>}
  <Tag class="title-serif text-4xl md:text-5xl" data-reveal>{title}{accent && <Fragment>{' '}<em>{accent}</em></Fragment>}</Tag>
  {lead && <p class="lead mt-5" data-reveal>{lead}</p>}
</div>
