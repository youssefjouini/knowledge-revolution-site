---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatDate, readingTime } from '@/lib/utils';
import Icon from './Icon.astro';
interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const { title, date, category, excerpt, cover, coverAlt } = post.data;
---
<article class="glass glass-hover group relative flex h-full flex-col overflow-hidden" data-tilt="5" data-reveal>
  <div class="relative aspect-[16/9] overflow-hidden bg-navy-700">
    {cover ? (
      <Image src={cover} alt={coverAlt ?? ''} widths={[400, 720]} sizes="(min-width: 1024px) 400px, 100vw" class="size-full object-cover transition duration-700 group-hover:scale-105" />
    ) : (
      <div class="flex size-full items-center justify-center text-cyan/40"><Icon name="book" class="size-12" /></div>
    )}
    <span class="chip absolute top-4 left-4 !border-white/20 !bg-navy/85 !text-gold backdrop-blur">{category}</span>
  </div>
  <div class="flex flex-1 flex-col p-6">
    <p class="font-label text-xs text-mist"><time datetime={date.toISOString()}>{formatDate(date)}</time> · {readingTime(post.body)} min read</p>
    <h3 class="mt-3 font-display text-2xl leading-snug text-ink">
      <a href={`/blog/${post.id}`} class="after:absolute after:inset-0">{title}</a>
    </h3>
    <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-mist">{excerpt}</p>
    <span class="mt-auto inline-flex items-center gap-2 pt-5 font-label text-sm font-semibold text-cyan" aria-hidden="true">
      Read the post <Icon name="arrow-right" class="size-4 transition group-hover:translate-x-1" />
    </span>
  </div>
</article>
