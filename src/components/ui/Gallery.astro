---
/** Image grid with an accessible lightbox (<dialog>, Esc to close, arrows to navigate). */
import { Image, getImage } from 'astro:assets';
interface Props { items: { img: ImageMetadata; alt: string; caption?: string }[]; class?: string }
const { items, class: cls } = Astro.props;
const full = await Promise.all(items.map((i) => getImage({ src: i.img, width: Math.min(1600, i.img.width) })));
---
<div class:list={['gallery', cls]}>
  <ul class="grid grid-cols-2 gap-4 md:grid-cols-4">
    {items.map((it, i) => (
      <li data-reveal>
        <button type="button" class="group block w-full overflow-hidden rounded-2xl border border-white/10 bg-navy-700 text-left" data-index={i} data-full={full[i].src} data-alt={it.alt} data-caption={it.caption ?? ''}>
          <Image src={it.img} alt={it.alt} widths={[300, 500]} sizes="(min-width: 768px) 25vw, 50vw" class="aspect-[4/5] w-full object-cover object-top transition duration-500 group-hover:scale-105" />
          {it.caption && <span class="block px-3 py-2 font-label text-xs text-mist">{it.caption}</span>}
        </button>
      </li>
    ))}
  </ul>
  <dialog class="lightbox m-auto max-h-[92vh] w-[min(92vw,70rem)] rounded-3xl border border-white/10 bg-navy-950/95 p-0 text-ink backdrop:bg-night/85 backdrop:backdrop-blur" aria-label="Image viewer">
    <figure class="relative flex flex-col items-center p-4 md:p-6">
      <img class="max-h-[75vh] w-auto rounded-xl object-contain" alt="" />
      <figcaption class="mt-3 font-label text-sm text-mist"></figcaption>
      <div class="mt-4 flex gap-2">
        <button type="button" data-nav="-1" class="btn-ghost !py-2" aria-label="Previous image">←</button>
        <button type="button" data-close class="btn-gold !py-2">Close</button>
        <button type="button" data-nav="1" class="btn-ghost !py-2" aria-label="Next image">→</button>
      </div>
    </figure>
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.gallery').forEach((g) => {
    const buttons = [...g.querySelectorAll<HTMLButtonElement>('button[data-index]')];
    const dialog = g.querySelector('dialog')!;
    const img = dialog.querySelector('img')!;
    const cap = dialog.querySelector('figcaption')!;
    let current = 0;
    const show = (i: number) => {
      current = (i + buttons.length) % buttons.length;
      const b = buttons[current];
      img.src = b.dataset.full!;
      img.alt = b.dataset.alt!;
      cap.textContent = b.dataset.caption || b.dataset.alt!;
    };
    buttons.forEach((b, i) => b.addEventListener('click', () => { show(i); dialog.showModal(); }));
    dialog.querySelectorAll<HTMLButtonElement>('[data-nav]').forEach((n) => n.addEventListener('click', () => show(current + Number(n.dataset.nav))));
    dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(current + 1);
      if (e.key === 'ArrowLeft') show(current - 1);
    });
    dialog.addEventListener('close', () => buttons[current].focus());
  });
</script>
