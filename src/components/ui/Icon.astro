interface Props { name: keyof typeof paths | string; class?: string; label?: string; strokeWidth?: number }
const { name, class: cls = 'size-5', label, strokeWidth = 1.6 } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={cls}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={paths[name] ?? ''}
/>
